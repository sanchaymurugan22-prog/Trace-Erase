{
  "name": "traceerase",
  "version": "2.0.0",
  "private": true,
  "description": "TraceErase: AI-powered platform to find, delete and prove deletion of your personal data.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "predev": "node scripts/cleanup-old-files.mjs",
    "prebuild": "node scripts/cleanup-old-files.mjs",
    "pretypecheck": "node scripts/cleanup-old-files.mjs",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run build && npm run start -w server",
    "typecheck": "npm run typecheck -w client",
    "test": "node server/scripts/smoke-test.js",
    "check:ai": "node server/scripts/check-ai.js",
    "reset": "node server/scripts/reset-data.js",
    "deploy:web": "npm run build:web -w client && firebase deploy --only hosting"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
